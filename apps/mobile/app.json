{
  "expo": {
    "name": "LOVE Mobile",
    "slug": "love-mobile",
    "version": "0.1.0",
    "scheme": "love",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "gov.fannincountyga.love"
