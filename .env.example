# LOVE - Library of Volunteer Experiences
# Environment Configuration Template
# Copy this file to .env.local and fill in the values

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="LOVE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ──────────────────────────────────────────────
# Backend Provider (convex | supabase | firebase)
# ──────────────────────────────────────────────
BACKEND_PROVIDER="convex"

# ──────────────────────────────────────────────
# Authentication Provider
# ──────────────────────────────────────────────
AUTH_PROVIDER="convex"
AUTH_SECRET=""

# ──────────────────────────────────────────────
# Convex (if BACKEND_PROVIDER=convex)
# ──────────────────────────────────────────────
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""

# ──────────────────────────────────────────────
# Supabase (if BACKEND_PROVIDER=supabase)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ──────────────────────────────────────────────
# Firebase (if BACKEND_PROVIDER=firebase)
# ──────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""

# ──────────────────────────────────────────────
# Notification Provider
# ──────────────────────────────────────────────
NOTIFICATION_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# ──────────────────────────────────────────────
# AI / Matching (future)
# ──────────────────────────────────────────────
AI_PROVIDER=""
OPENAI_API_KEY=""

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────
FEATURE_AI_MATCHING="false"
FEATURE_SMS_NOTIFICATIONS="false"
FEATURE_PUSH_NOTIFICATIONS="false"
FEATURE_MFA="false"
