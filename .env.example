# ─────────────────────────────────────────────────────────────
# LOVE - Library of Volunteer Experiences
# Environment configuration template
# ─────────────────────────────────────────────────────────────
# Copy to apps/web/.env.local (web) and fill in values.
# NEVER commit real values. Every variable is validated by
# packages/config/src/env.ts — see that file for the full list.
#
# NEXT_PUBLIC_* and EXPO_PUBLIC_* values are shipped to browsers
# and phones. NEVER put a secret behind those prefixes.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
# development | test | staging | production
# staging/production enforce that all provider credentials are present.
APP_ENV="development"
NEXT_PUBLIC_APP_NAME="LOVE"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Backend provider: ONE value switches db + auth + storage ─
# convex | supabase | firebase
BACKEND_PROVIDER="convex"
# Optional per-concern overrides (leave blank normally)
AUTH_PROVIDER=""
STORAGE_PROVIDER=""

# ── Auth ─────────────────────────────────────────────────────
# >= 32 random characters in staging/production:  openssl rand -base64 48
AUTH_SECRET=""

# ── Convex ───────────────────────────────────────────────────
CONVEX_URL=""
CONVEX_DEPLOY_KEY=""

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Firebase ─────────────────────────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ── Notifications (one provider per channel) ─────────────────
# email: none | console | smtp | sendgrid     (console = dev only)
# sms:   none | console | twilio
# push:  none | console | expo
NOTIFICATION_EMAIL_PROVIDER=""
NOTIFICATION_SMS_PROVIDER=""
NOTIFICATION_PUSH_PROVIDER=""
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
EXPO_PUSH_ACCESS_TOKEN=""

# ── AI matching (future) ─────────────────────────────────────
# none | openai | anthropic | azure-openai
AI_PROVIDER="none"
AI_API_KEY=""
AI_EXTRACTION_MODEL=""
AI_EMBEDDING_MODEL=""

# ── Feature flags (all default to false) ─────────────────────
FEATURE_AI_MATCHING="false"
FEATURE_SMS_NOTIFICATIONS="false"
FEATURE_PUSH_NOTIFICATIONS="false"
FEATURE_MAGIC_LINK="false"
FEATURE_OAUTH="false"
FEATURE_MFA="false"
FEATURE_MOBILE_API="false"

# ── Mobile (apps/mobile/.env) ────────────────────────────────
EXPO_PUBLIC_APP_NAME="LOVE"
EXPO_PUBLIC_API_URL="http://localhost:3000"
