{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "APP_*",
    "BACKEND_PROVIDER",
    "AUTH_*",
    "STORAGE_PROVIDER",
    "NOTIFICATION_PROVIDER",
    "CONVEX_*",
    "SUPABASE_*",
    "FIREBASE_*",
    "SMTP_*",
    "SENDGRID_*",
    "TWILIO_*",
    "EXPO_PUSH_*",
    "AI_*",
    "FEATURE_*",
    "NEXT_PUBLIC_*",
    "EXPO_PUBLIC_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {},
    "clean": {
      "cache": false
    }
  }
}
